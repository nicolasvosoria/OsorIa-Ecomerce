{
  "name": "osoria-ecommerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint app/api/store app/api/orders/send-confirmation-email lib/security tests/security tests/quality --max-warnings=0",
    "lint:full": "eslint . --max-warnings=0",
    "start": "next start",
    "test": "node scripts/run-vitest.mjs",
    "test:full": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.quality.json",
    "typecheck:full": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:verify": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -v ON_ERROR_STOP=1 -f supabase/checks/verify-ecommerce-contract.sql",
    "supabase:types": "supabase gen types typescript --local --schema ecommerce > lib/supabase/database.types.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
