# Copy this file to .env.local and fill in real values.
# Never commit real secrets — this file only holds placeholders.

# --- Required for app boot ---------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Admin active-store cookie (required in production) ----------------
# Signs/verifies the `active-store` cookie that gates the admin panel's
# store switcher (lib/admin/active-store-cookie.ts). In production the app
# refuses to start without it (see instrumentation.ts) — without a secret,
# the switcher silently falls back to resolving the store from the request
# host on every admin request.
# Generate one with: openssl rand -hex 32
ADMIN_COOKIE_SECRET=

# --- Multi-tenant toggle (proxy.ts and store helpers) -------------------
DISABLE_SUBDOMAIN_MULTI_TENANT=
DEFAULT_STORE_ID=
NEXT_PUBLIC_DISABLE_SUBDOMAIN_MULTI_TENANT=
NEXT_PUBLIC_DEFAULT_STORE_ID=

# --- Chat API enrichment (app/api/chat/route.ts) -------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# --- Order confirmation email (app/api/orders/send-confirmation-email) --
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Your Store <no-reply@example.com>"
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Optional storefront/domain ------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Optional business rules (lib/date/business-day.ts) ------------------
# UTC offset, in hours, used to compute the store's business day. Defaults
# to -5 when unset.
BUSINESS_UTC_OFFSET_HOURS=
